          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('hanya nota_dinas yang berubah', () => {",
                  "    pm.expect(json.data.nota_dinas).to.eql(Number(pm.collectionVariables.get('nota_dinas_id')));",
                  "    pm.expect(String(json.data.tag_number_ids)).to.eql(pm.collectionVariables.get('awal_tag_number_ids'));",
                  "    pm.expect(String(json.data.no_notif)).to.eql(pm.collectionVariables.get('awal_no_notif'));",
                  "});",
                  "pm.test('no_dokumen diambil dari relasi', () => {",
                  "    pm.expect(json.data).to.have.property('no_dokumen');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nota_dinas\": {{nota_dinas_id}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/monitoring_memorandum/{{created_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitoring_memorandum", "{{created_id}}"]
            },
            "description": "Aturan `sometimes` pada UpdateRequest membuat field yang tidak dikirim tidak ikut berubah. `no_dokumen` ikut tampil karena dibaca dari relasi `historicalMemorandum`, bukan kolom tersimpan. Sesuaikan `nota_dinas_id` bila ID tersebut tidak ada di database Anda."
          }
        },
        {
          "name": "Update: kosongkan nota_dinas dengan null → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('nota_dinas menjadi null', () => {",
                  "    pm.expect(pm.response.json().data.nota_dinas).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nota_dinas\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/monitoring_memorandum/{{created_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitoring_memorandum", "{{created_id}}"]
            },
            "description": "String kosong (`\"\"`) juga dinormalisasi menjadi `null` di `prepareForValidation()`."
          }
        },
        {
          "name": "Update tanggal di masa depan → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "pm.test('errors.tanggal_issue ada', () => {",
                  "    pm.expect(pm.response.json().errors).to.have.property('tanggal_issue');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tanggal_issue\": \"2099-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/monitoring_memorandum/{{created_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitoring_memorandum", "{{created_id}}"]
            }
          }
        }
      ]
