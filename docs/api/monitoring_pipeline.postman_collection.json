              "host": ["{{baseUrl}}"],
              "path": ["api", "monitoring_pipeline", "{{monitoring_pipeline_id}}"]
            },
            "description": "Blok `tag_number`, `description`, `unit_id`, `type_id` ikut terisi di response show (relasi tagNumber di-eager-load)."
          }
        },
        {
          "name": "Show (id tidak ada → 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('message No query results', () => {",
                  "    pm.expect(pm.response.json().message).to.include('No query results');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/monitoring_pipeline/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitoring_pipeline", "999999"]
            }
          }
        }
      ]
    },
    {
      "name": "4. CRUD",
      "item": [
        {
          "name": "Create valid → 201 (simpan created_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('sukses + data tersimpan', () => {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.id).to.be.a('number');",
                  "    pm.expect(json.data.tag_number_id).to.eql(Number(pm.collectionVariables.get('tag_number_id')));",
                  "    pm.expect(json.data.insulation).to.eql('Yes');",
                  "});",
                  "pm.collectionVariables.set('created_id', json.data.id);",
                  "console.log('created_id =', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag_number_id\": {{tag_number_id}},\n  \"tml_drawing_number\": \"TML-POSTMAN-001\",\n  \"api_service_class\": 2,\n  \"insulation\": \"Yes\",\n  \"grade_material\": \"SA106 GR B\",\n  \"nps\": 2,\n  \"od\": 60.3,\n  \"sch\": \"40\",\n  \"t_nom\": 3.91,\n  \"operating_press\": 10,\n  \"design_press\": 14,\n  \"design_temp\": 250,\n  \"s\": 138,\n  \"e\": 1,\n  \"w\": 1,\n  \"y\": 0.4,\n  \"min_req_thk\": 2.1,\n  \"half_nom_thk\": 1.955,\n  \"tanggal_pasang_line\": \"2019-03-10\",\n  \"actual_thk\": 3.7,\n  \"tanggal_ut_terakhir\": \"2025-01-20\",\n  \"corrosion_rate\": 0.015,\n  \"remaining_life\": 120,\n  \"alert_structural_thickness\": 2.5,\n  \"next_plan_inspection_api\": \"2028-01-20\",\n  \"used_plan_inspection\": \"2025-01-20\",\n  \"pipe_condition\": \"GOOD CONDITION\",\n  \"estimated_end_of_life\": \"2045-01-01\",\n  \"maintenance_status\": \"MONITORING UT\",\n  \"rencana_tindak_lanjut\": \"Normal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/monitoring_pipeline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitoring_pipeline"]
            },
            "description": "Variabel `tag_number_id` default `8` (tag `1-V-06/00`) — tag ini dipakai karena belum punya baris monitoring. Kalau sudah ada (sisa uji sebelumnya), request ini akan 422 duplikat; hapus dulu barisnya lewat folder Bersih-bersih. Request Delete di folder ini otomatis membersihkan baris yang dibuat di sini."
          }
        },
        {
          "name": "Create duplikat tag_number_id → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "pm.test('errors.tag_number_id = already been taken', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.message).to.eql('Validation failed.');",
                  "    pm.expect(body.errors.tag_number_id[0]).to.include('already been taken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag_number_id\": {{tag_number_id}},\n  \"grade_material\": \"DUPLIKAT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/monitoring_pipeline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "monitoring_pipeline"]
            },
            "description": "Menegakkan FK unik: 1 tag hanya boleh punya 1 baris monitoring pipeline."
          }
        },
        {
          "name": "Create insulation bukan Yes/No → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "pm.test('errors.insulation ada', () => {",
                  "    pm.expect(pm.response.json().errors).to.have.property('insulation');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag_number_id\": 9,\n  \"insulation\": \"Maybe\"\n}"
            },
